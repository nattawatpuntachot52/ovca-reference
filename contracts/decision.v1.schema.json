{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovca.dev/contracts/decision.v1.schema.json",
  "title": "OVCA Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "decision_id", "made_by", "disposition", "rationale", "evidence_refs", "made_at"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "decision_id": { "type": "string", "minLength": 1 },
    "made_by": { "enum": ["owner", "coordinator", "engineer", "reviewer", "auditor"] },
    "disposition": { "enum": ["pass", "repair", "escalate"] },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "made_at": { "type": "string", "format": "date-time" }
  }
}
