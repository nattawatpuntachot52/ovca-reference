{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovca.dev/contracts/authority.v1.schema.json",
  "title": "OVCA Authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "authority_id", "granted_by", "objective", "scope", "constraints"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "authority_id": { "type": "string", "minLength": 1 },
    "granted_by": { "const": "owner" },
    "objective": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
