{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovca.dev/contracts/authorization_mandate.v1.schema.json",
  "title": "OVCA AuthorizationMandate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mandate_id",
    "authority_id",
    "origin_thread_id",
    "source_kind",
    "receiving_scope",
    "requester_actor",
    "requester_is_bot",
    "strength",
    "policy_version",
    "matched_rules",
    "writable_scope",
    "status",
    "issued_at"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "mandate_id": { "type": "string", "minLength": 1 },
    "authority_id": { "type": "string", "minLength": 1 },
    "origin_thread_id": { "type": "string", "minLength": 1 },
    "source_kind": {
      "enum": [
        "owner_cli",
        "github_issue",
        "github_pr",
        "github_comment",
        "github_default_branch_ci",
        "bot"
      ]
    },
    "receiving_scope": {
      "enum": [
        "owner_cli",
        "github_issue",
        "github_pr",
        "github_comment",
        "github_default_branch_ci"
      ]
    },
    "requester_actor": { "type": "string", "minLength": 1 },
    "requester_is_bot": { "type": "boolean" },
    "strength": { "enum": ["explicit", "inferred"] },
    "policy_version": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "matched_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "writable_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "enum": ["active", "ended", "stopped_by_person", "revoked"]
    },
    "issued_at": { "type": "string", "minLength": 1 }
  }
}
