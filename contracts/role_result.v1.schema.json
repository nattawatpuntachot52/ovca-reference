{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovca.dev/contracts/role_result.v1.schema.json",
  "title": "OVCA Role Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "result_id", "invocation_ref", "role", "status", "summary", "evidence", "completed_at"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "result_id": { "type": "string", "minLength": 1 },
    "invocation_ref": { "type": "string", "minLength": 1 },
    "role": { "enum": ["owner", "coordinator", "engineer", "reviewer", "auditor"] },
    "status": { "enum": ["succeeded", "failed"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "evidence.v1.schema.json" } },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
