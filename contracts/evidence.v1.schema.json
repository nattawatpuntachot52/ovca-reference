{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovca.dev/contracts/evidence.v1.schema.json",
  "title": "OVCA Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "evidence_id", "kind", "summary", "source", "collected_at"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "evidence_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["input", "implementation", "verification", "review", "audit", "decision"] },
    "summary": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "collected_at": { "type": "string", "format": "date-time" }
  }
}
